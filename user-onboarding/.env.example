# =============================================================================
# SafeMate User Onboarding Lambda Environment Configuration
# =============================================================================
# 
# This file contains the environment variables required for the SafeMate
# User Onboarding Lambda function to operate correctly.
#
# Environment: Development (dev)
# Last Updated: 2025-01-15
# Status: Fixed email verification, wallet ID format, and validation logic
#
# =============================================================================

# AWS Configuration
AWS_REGION=ap-southeast-2

# DynamoDB Configuration
WALLETS_TABLE=safemate-wallets-dev

# KMS Configuration
USER_KEYS_KMS_KEY_ID=alias/safemate-user-keys-dev

# Cognito Configuration
COGNITO_USER_POOL_ID=ap-southeast-2_bUngJqSfu

# Hedera Configuration
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.123456
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Node Environment
NODE_ENV=development

# =============================================================================
# Notes:
# - All sensitive data is stored in DynamoDB with KMS encryption
# - No Secrets Manager usage (Free Tier compliant)
# - Real Hedera testnet integration
# - Dynamic CORS handling for multiple environments
# =============================================================================
